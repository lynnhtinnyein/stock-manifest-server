APP_NAME=stock-manifest-server
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ----------------------------------------
# Logging
# ----------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ----------------------------------------
# Database configuration
# ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=stock_manifest
DB_USERNAME=root
DB_PASSWORD=

# ----------------------------------------
# Queue, cache, and file storage
# ----------------------------------------
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

# ----------------------------------------
# Redis configuration
# ----------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ----------------------------------------
# Mail configuration
# ----------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ----------------------------------------
# AWS configuration
# ----------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ----------------------------------------
# Vite app
# ----------------------------------------
VITE_APP_NAME="${APP_NAME}"

# ----------------------------------------
# Authentication
# ----------------------------------------
AUTH_MAX_LOGIN_ATTEMPTS=10
AUTH_RATE_LIMIT_DECAY=1

# ----------------------------------------
# Postman API (optional)
# ----------------------------------------
POSTMAN_API_KEY=
POSTMAN_WORKSPACE_ID=
POSTMAN_COLLECTION_ID=

# ----------------------------------------
# Sanctum configuration
# ----------------------------------------
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# ----------------------------------------
# CORS configuration
# ----------------------------------------
CORS_SUPPORTS_CREDENTIALS=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ----------------------------------------
# Token configuration
# ----------------------------------------
TOKEN_LIFETIME=3600
TOKEN_REMEMBER_LIFETIME=2592000

# ----------------------------------------
# Session configuration
# ----------------------------------------
SESSION_DRIVER=array

# ----------------------------------------
# PDF Generation
# ----------------------------------------
USE_BROWSERSHOT=false

# Browsershot Configuration (only needed if USE_BROWSERSHOT=true)
BROWSERSHOT_NODE_BINARY=
BROWSERSHOT_NPM_BINARY=

# Docskie API Configuration
DOCSKIE_API_URL=https://docskie.onrender.com/api/html-to-pdf

# ----------------------------------------
# Attachment storage configuration
# ----------------------------------------
ATTACHMENT_MAX_FILE_SIZE_KB=10240
ATTACHMENT_MAX_FILES=5
